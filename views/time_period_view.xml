<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List -->
    <record id="view_time_period_list" model="ir.ui.view">
        <field name="name">time.period.list</field>
        <field name="model">time.period</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_generate_current_year" type="object"
                            string="Generate Current Year" display="always"/>
                </header>
                <field name="name"/>
                <field name="grain"/>
                <field name="period_index" optional="hide"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="year"/>
                <field name="month" optional="show"/>
                <field name="day" optional="hide"/>
                <field name="day_of_week" optional="hide"/>
                <field name="week_of_year" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_time_period_form" model="ir.ui.view">
        <field name="name">time.period.form</field>
        <field name="model">time.period</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Period">
                            <field name="grain"/>
                            <field name="period_index"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                        <group string="Calendar Attributes">
                            <field name="year"/>
                            <field name="month"/>
                            <field name="day"/>
                            <field name="day_of_week"/>
                            <field name="week_of_year"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_time_period_search" model="ir.ui.view">
        <field name="name">time.period.search</field>
        <field name="model">time.period</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="year"/>
                <field name="month"/>
                <filter name="grain_day" string="Days" domain="[('grain', '=', 'day')]"/>
                <filter name="grain_week" string="Weeks" domain="[('grain', '=', 'week')]"/>
                <filter name="grain_month" string="Months" domain="[('grain', '=', 'month')]"/>
                <filter name="grain_quarter" string="Quarters" domain="[('grain', '=', 'quarter')]"/>
                <filter name="grain_year" string="Years" domain="[('grain', '=', 'year')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_grain" string="Grain" context="{'group_by': 'grain'}"/>
                    <filter name="group_year" string="Year" context="{'group_by': 'year'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Pivot -->
    <record id="view_time_period_pivot" model="ir.ui.view">
        <field name="name">time.period.pivot</field>
        <field name="model">time.period</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="year" type="row"/>
                <field name="grain" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- Action -->
    <record id="action_time_period" model="ir.actions.act_window">
        <field name="name">Time Periods</field>
        <field name="res_model">time.period</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="search_view_id" ref="view_time_period_search"/>
        <field name="context">{'search_default_grain_day': 1}</field>
    </record>
</odoo>