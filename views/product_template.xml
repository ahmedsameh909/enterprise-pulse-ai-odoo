<odoo>
    <record id="product_template_form_inherit_enterprisepulse" model="ir.ui.view">
        <field name="name">product.template.form.inherit.enterprisepulse</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Enterprise Pulse Data Context" name="enterprise_pulse_context">
                    <group>
                        <field name="source_dataset_id"/>
                        <field name="source_record_id"/>
                        <field name="create_date" readonly="1"/>
                        <field name="write_date" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
